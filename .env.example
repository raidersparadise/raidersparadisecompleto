APP_NAME="Raiders Paradise"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=America/Bogota

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CO

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------
# Base de datos
# Opción A (por defecto, sin instalar nada): SQLite -> database/database.sqlite
# Opción B: MySQL (XAMPP/Laragon o Docker). Comenta la línea de SQLite
#           y descomenta el bloque MySQL. Con docker-compose usa puerto 3308.
# ---------------------------------------------------------------
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=raidersparadise
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Correo SMTP (alertas de stock y demás notificaciones) ---
# Para enviar correos reales cambia MAIL_MAILER=log por smtp y completa:
# Gmail: activa la verificación en 2 pasos y crea una "contraseña de aplicación"
# en https://myaccount.google.com/apppasswords (16 caracteres, sin espacios).
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=tucorreo@gmail.com
# MAIL_PASSWORD=contrasena_de_aplicacion
# MAIL_FROM_ADDRESS="tucorreo@gmail.com"
# Pruebas locales sin enviar (Mailpit): MAIL_MAILER=smtp, MAIL_HOST=127.0.0.1, MAIL_PORT=1025 -> http://localhost:8025
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="tienda@raidersparadise.co"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
