<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Configuración de phpDocumentor (herramienta oficial de PHPDoc) para Raiders Paradise.
    Genera la documentación HTML de la API en docs/phpdoc a partir de los comentarios PHPDoc.

    Uso (opcional):
      1. Descargar phpDocumentor.phar desde https://phpdoc.org
      2. php phpDocumentor.phar

    El proyecto también incluye un generador propio sin dependencias:
      php tools/generar-documentacion.php   (salida en docs/api)
-->
<phpdocumentor configVersion="3" xmlns="https://www.phpdoc.org">
    <title>Raiders Paradise — Documentación del código</title>
    <paths>
        <output>docs/phpdoc</output>
        <cache>storage/framework/cache/phpdoc</cache>
    </paths>
    <version number="2.0.0">
        <api>
            <source dsn=".">
                <path>app</path>
                <path>database/seeders</path>
                <path>database/migrations</path>
            </source>
            <visibility>public</visibility>
            <visibility>protected</visibility>
            <visibility>private</visibility>
            <default-package-name>RaidersParadise</default-package-name>
        </api>
    </version>
</phpdocumentor>
